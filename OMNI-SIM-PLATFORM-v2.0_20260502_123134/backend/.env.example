USE_SQLITE=true

# 数据库配置
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=game_training
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI API 配置
# Claude API (Anthropic)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_MODEL=claude-3-sonnet-20240229

# 千问 API (阿里云)
QIANWEN_API_KEY=your-qianwen-api-key-here
QIANWEN_API_URL=https://dashscope.aliyuncs.com/api/text/generation
QIANWEN_MODEL=qwen-turbo

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 默认AI模型 (claude/qianwen/deepseek)
DEFAULT_AI_MODEL=claude

# 应用配置
APP_NAME=游戏化培训平台 2.0
APP_ENV=development
APP_PORT=8000
